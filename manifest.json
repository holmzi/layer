{
    "manifest_version": 3,
    "name": "Layer",
    "version": "1.0.0",
    "description": "Edit custom CSS for every website or just the current one.",
    "minimum_chrome_version": "127",
    "permissions": ["storage", "scripting"],
    "host_permissions": ["<all_urls>"],
    "icons": { "128": "res/icons/128.png" },
    "action": {
        "default_title": "Layer",
        "default_popup": "src/popup/index.html"
    },
    "background": {
        "service_worker": "src/background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/settings.js", "src/content.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
